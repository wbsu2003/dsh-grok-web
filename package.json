{
  "name": "dsh-grok-web",
  "version": "0.1.0",
  "description": "Unofficial DSH plugin: use grok.com web models as a DSH LLM provider (browser login capture + mgw WebSocket streaming + prompting-based tool calls), provider route grok-web",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "scripts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "scripts": {
    "test": "node --test",
    "login": "node scripts/login.mjs",
    "probe": "node scripts/probe.mjs"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis-plugin",
    "grok",
    "llm",
    "provider"
  ],
  "license": "Apache-2.0"
}
